{
	"mcpServers": {
		"fluxcd": {
			"command": "/home/linuxbrew/.linuxbrew/bin/flux-operator-mcp",
			"args": [
				"serve"
			],
			"env": {
				"KUBECONFIG": "/home/gpenda/.kube/config"
			},
			"alwaysAllow": [
				"get_flux_instance",
				"search_flux_docs",
				"reconcile_flux_source",
				"reconcile_flux_helmrelease",
				"get_kubernetes_resources",
				"get_kubernetes_logs",
				"get_kubernetes_api_versions",
				"get_kubeconfig_contexts",
				"reconcile_flux_kustomization"
			],
			"disabled": true
		},
		"kubernetes": {
			"command": "npx",
			"args": [
				"-y",
				"kubernetes-mcp-server@latest"
			],
			"alwaysAllow": [
				"configuration_view",
				"events_list",
				"namespaces_list",
				"nodes_log",
				"nodes_stats_summary",
				"nodes_top",
				"pods_get",
				"pods_list",
				"pods_list_in_namespace",
				"pods_log",
				"pods_top",
				"resources_get",
				"resources_list",
				"configuration_contexts_list",
				"pods_exec"
			]
		},
		"talos": {
			"command": "npx",
			"args": [
				"-y",
				"talos-mcp"
			],
			"alwaysAllow": [
				"talos_version",
				"talos_validate",
				"talos_services",
				"talos_resource_definitions",
				"talos_read_file",
				"talos_processes",
				"talos_logs",
				"talos_list_files",
				"talos_health",
				"talos_get",
				"talos_events",
				"talos_etcd",
				"talos_dmesg",
				"talos_containers",
				"talos_etcd_snapshot",
				"talos_service_action"
			],
			"disabled": true
		}
	}
}