{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "gitea": {
        "type": "remote",
        "url": "https://gitea-mcp.teamg.app/mcp"
      },
      "kubernetes": {
        "type": "remote",
        "url": "https://k8s-mcp.teamg.app/mcp"
      },
      "talos": {
        "type": "local",
        "command": ["npx", "-y", "talos-mcp"],
        "environment": {
          "TALOS_MCP_ENABLE_INSECURE": "true",
          "TALOS_MCP_INSECURE_ALLOWED_NODES": "10.25.25.0/24"
        }
      }
    }
  }
}
