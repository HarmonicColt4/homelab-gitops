{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "talos": {
        "type": "local",
        "command": ["npx", "-y", "talos-mcp"],
        "environment": {
          "TALOS_MCP_ENABLE_INSECURE": "true",
          "TALOS_MCP_INSECURE_ALLOWED_NODES": "10.25.25.0/24"
        }
      }
    }
  },
  "permissions": [
    { "action": "talos_talos_upgrade", "resource": "*", "effect": "deny" },
    { "action": "talos_talos_rollback", "resource": "*", "effect": "deny" },
    { "action": "talos_talos_reset", "resource": "*", "effect": "deny" },
    { "action": "talos_talos_patch_config", "resource": "*", "effect": "deny" },
    { "action": "talos_talos_meta", "resource": "*", "effect": "deny" }
  ]
}
