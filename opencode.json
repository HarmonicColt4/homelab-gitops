{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "flux": {
        "type": "local",
        "command": [
          "/home/linuxbrew/.linuxbrew/bin/flux-operator-mcp",
          "serve",
          "-n",
          "flux-system"
        ],
        "environment": {
          "KUBECONFIG": "{env:HOME}/.kube/config"
        }
      },
      "gitea": {
        "type": "remote",
        "url": "https://gitea-mcp.teamg.app/mcp"
      },
      "kubernetes": {
        "type": "remote",
        "url": "https://k8s-mcp.teamg.app/mcp"
      },
      "talos": {
        "type": "local",
        "command": ["npx", "-y", "talos-mcp"]
      }
    }
  }
}
