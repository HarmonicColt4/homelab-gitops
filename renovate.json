{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository|unifi/values)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/controllers/dietpi/renovate/cronjob.yml/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchDepNames": ["adguard-home", "jellyfin", "minecraft"],
      "schedule": ["* 2-6 * * *"]
    }
  ]
}
