{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository)\\.yml/"]
  },
  "extends": [
    "config:recommended",
    ":automergeStableNonMajor",
    "schedule:automergeWeekly"
  ],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": ["/cronjob\\.yml/", "/deploy\\.yml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDepNames": [
        "fluxcd/flux2",
        "cert-manager",
        "metallb",
        "cloudflareddns",
        "vaultwarden"
      ],
      "automerge": false
    }
  ]
}
