{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/controllers/renovate/cronjob.yml/",
      "/deploy\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchDepNames": ["adguard-home", "jellyfin"],
      "schedule": ["* 2-6 * * *"]
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Helm release {{{depName}}}"
    },
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDepNames": [
        "fluxcd/flux2",
        "cert-manager",
        "metallb",
        "cloudflareddns",
        "vaultwarden"
      ],
      "automerge": false
    }
  ]
}
