{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "schedule": ["* 1-7 * * *"],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": ["/cronjob\\.yml/", "/deploy\\.yml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDepNames": ["fluxcd/flux2", "cert-manager", "metallb", "longhorn"],
      "lockFileMaintenance": {
        "automerge": true
      },
      "minor": {
        "automerge": false
      },
      "patch": {
        "automerge": true
      },
      "pin": {
        "automerge": true
      },
      "separateMinorPatch": true
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Helm release {{{depName}}}"
    }
  ]
}
