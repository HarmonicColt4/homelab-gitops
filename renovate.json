{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": [
      "/apps/.+(?:helmrelease|repository)\\.yml/",
      "/infrastructure/monitoring/.*\\.yml/"
    ]
  },
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":automergeStableNonMajor"
  ],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/controllers/dietpi/renovate/cronjob.yml/"
    ]
  }
}
