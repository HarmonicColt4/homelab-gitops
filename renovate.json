{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": [
      "apps/base/.+\\.yml$",
      "infrastructure/monitoring/.+\\.yml$"
    ]
  },
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":automergeMinor",
    "schedule:daily"
  ],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": [
      "infrastructure/controllers/dietpi/renovate/cronjob.yml"
    ]
  }
}
