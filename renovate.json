{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository|unifi/values)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "ignoreTests": true,
  "automergeType": "branch",
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/controllers/dietpi/renovate/cronjob.yml/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchDepNames": ["adguard-home", "jellyfin", "minecraft-java"],
      "schedule": ["* 2-6 * * *"]
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Helm release {{{depName}}}"
    },
    {
      "matchManagers": ["flux"],
      "matchDepNames": [
        "fluxcd/flux2",
        "secrets-operator",
        "cert-manager",
        "metallb",
        "longhorn"
      ],
      "automerge": false
    }
  ]
}
