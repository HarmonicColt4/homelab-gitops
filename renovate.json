{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeMinor"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 5,
  "kubernetes": {
    "managerFilePatterns": [
      "/cronjob\\.yml/",
      "/deploy\\.yml$/",
      "/login-job\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Talos Linux version in the Image Factory installer image (e.g. talos/clusters/home/patches/hedy.yml)",
      "managerFilePatterns": ["/talos/clusters/.*/patches/.*\\.yml$/"],
      "matchStrings": [
        "image: factory\\.talos\\.dev/metal-installer/[^:]+:(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the Talos Linux version and digest of the Raspberry Pi 5 image (e.g. talos/clusters/home/patches/rpi5.yml)",
      "managerFilePatterns": ["/talos/clusters/.*/patches/.*\\.yml$/"],
      "matchStrings": [
        "image: (?<depName>ghcr\\.io/yama6a/talos-raspberry-pi5):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the Terraform version documented in the Terraform root module README (e.g. terraform/talos-clusters/home/README.md)",
      "managerFilePatterns": ["/terraform/talos-clusters/.*/README\\.md$/"],
      "matchStrings": [
        "Terraform `(?:~> )?(?<currentValue>\\d+\\.\\d+\\.\\d+)`"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/terraform",
      "versioningTemplate": "hashicorp"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: arcade (tags are arcade-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>arcade-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^arcade-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: cast (tags are cast-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>cast-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^cast-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: draw-io (tags are draw-io-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>draw-io-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^draw-io-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: external-sites (tags are external-sites-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>external-sites-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^external-sites-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: importer (tags are importer-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>importer-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^importer-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: json-viewer (tags are json-viewer-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>json-viewer-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^json-viewer-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: maps (tags are maps-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>maps-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^maps-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: progress-bars (tags are progress-bars-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>progress-bars-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^progress-bars-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "OpenCloud web extension: unzip (tags are unzip-<semver>)",
      "managerFilePatterns": [
        "/^fluxcd/apps/opencloud/deploy\\.yml$/"
      ],
      "matchStrings": [
        "opencloudeu/web-extensions:(?<currentValue>unzip-\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "opencloudeu/web-extensions",
      "versioningTemplate": "regex:^unzip-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "rebaseWhen": "conflicted",
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Never automerge pre-1.0 dependencies; 0.x may break at any time",
      "matchCurrentVersion": "/^[~^<>=v\\s]*0\\./",
      "automerge": false,
      "assignees": ["gpenda"]
    },
    {
      "description": "Terraform core and provider minor/major bumps require manual review (no automerge); patches automerge",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "assignees": ["gpenda"]
    },
    {
      "description": "Group the Terraform core version update in version.tf with the version documented in README.md",
      "matchDepNames": ["hashicorp/terraform"],
      "groupName": "Terraform core",
      "assignees": ["gpenda"]
    },
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDepNames": ["fluxcd/flux2", "cert-manager", "longhorn"],
      "automerge": false
    },
    {
      "description": "Talos upgrades reboot nodes: manual review, 14-day wait, one PR per node. One node at a time is enforced by the upgrade workflow, not by prConcurrentLimit (Renovate checks that limit against a repo-wide open-PR count)",
      "matchDepNames": [
        "siderolabs/talos",
        "ghcr.io/yama6a/talos-raspberry-pi5"
      ],
      "automerge": false,
      "minimumReleaseAge": "14 days",
      "additionalBranchPrefix": "talos-{{{replace '^.*/(.*)\\.yml$' '$1' packageFile}}}-",
      "semanticCommitScope": "talos/{{{replace '^.*/(.*)\\.yml$' '$1' packageFile}}}",
      "commitMessageTopic": "Talos Linux"
    },
    {
      "description": "SearXNG publishes date-based tags (YYYY.M.DD-<sha>); use regex versioning so Renovate can order them",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": [
        "ghcr.io/searxng/searxng",
        "docker.io/searxng/searxng",
        "searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$"
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Helm release {{{depName}}}"
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "automergeType": "branch"
    },
    {
      "matchDepNames": [
        "adguard-home",
        "seerr",
        "ghcr.io/lemker/unifi-os-server"
      ],
      "automergeSchedule": ["* 2-6 * * *"]
    },
    {
      "description": "Hermes Agent is a stateful single-replica agent; never automerge, and wait a week after release",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "assignees": ["gpenda"]
    },
    {
      "description": "beellama.cpp tags are <backend>-vX.Y.Z (e.g. server-cuda13-v0.4.9); default docker versioning cannot parse the backend prefix, so scope candidates to the CUDA 13 backend",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["ghcr.io/anbeeld/beellama.cpp"],
      "versioning": "regex:^server-cuda13-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "OpenCloud only starts once its Tika sidecar and every web extension init container have succeeded, so a bad tag is an outage; review these by hand",
      "matchPackageNames": [
        "opencloudeu/opencloud-rolling",
        "docker.io/opencloudeu/opencloud-rolling",
        "apache/tika",
        "docker.io/apache/tika",
        "opencloudeu/web-extensions"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "assignees": [
        "gpenda"
      ]
    },
    {
      "description": "One deploy.yml entry per extension; keep their bumps in a single PR",
      "matchPackageNames": [
        "opencloudeu/web-extensions"
      ],
      "groupName": "OpenCloud web extensions"
    },
    {
      "description": "Docker versioning cannot order the prefixed extension tags (arcade-3.0.0 vs cast-1.0.0); the custom.regex managers above handle them",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "opencloudeu/web-extensions"
      ],
      "enabled": false
    }
  ],
  "major": {
    "assignees": ["gpenda"]
  }
}
