{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": ["/.+(?:helmrelease|repository)\\.yml/"]
  },
  "extends": ["config:recommended", ":automergeMinor"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 5,
  "kubernetes": {
    "managerFilePatterns": ["/cronjob\\.yml/", "/deploy\\.yml$/"]
  },
  "rebaseWhen": "conflicted",
  "ignoreTests": true,
  "packageRules": [
    {
      "matchManagers": ["flux", "kubernetes"],
      "matchDepNames": ["fluxcd/flux2", "cert-manager", "metallb", "longhorn"],
      "automerge": false
    },
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Helm release {{{depName}}}"
    },
    {
      "matchPackageNames": ["renovate/renovate"],
      "automergeType": "branch"
    },
    {
      "description": "Only update adguard-home, seerr and unifi between 2am and 6am",
      "matchPackageNames": [
        "adguard-home",
        "seerr",
        "ghcr.io/lemker/unifi-os-server"
      ],
      "timezone": "Pacific/Auckland",
      "schedule": ["* 2-6 * * *"]
    }
  ],
  "major": {
    "assignees": ["gpenda"]
  }
}
