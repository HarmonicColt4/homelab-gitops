{
  "mcpServers": {
    "talos": {
      "command": "npx",
      "args": ["-y", "talos-mcp"],
      "alwaysAllow": [
        "talos_validate",
        "talos_resource_definitions",
        "talos_read_file",
        "talos_processes",
        "talos_logs",
        "talos_list_files",
        "talos_health",
        "talos_etcd",
        "talos_dmesg",
        "talos_containers",
        "talos_get",
        "talos_version",
        "talos_services"
      ],
      "disabledTools": [
        "talos_upgrade",
        "talos_rollback",
        "talos_reset",
        "talos_patch_config",
        "talos_meta"
      ],
      "env": {
        "TALOS_MCP_ENABLE_INSECURE": "true",
        "TALOS_MCP_INSECURE_ALLOWED_NODES": "10.13.25.0/24"
      }
    }
  }
}
